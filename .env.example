# Copy to .env.local, then restart Vite. Also set these in Vercel and redeploy.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Server only. NEVER prefix these with VITE_ or NEXT_PUBLIC_.
# Use a unique password of at least 20 characters. Admin stays locked if unset.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
